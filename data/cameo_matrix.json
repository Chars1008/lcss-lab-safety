    {"a": "RG01", "b": "RG09", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "HEAT"], "summary": "酸液與次氯酸鈉（漂白水）接觸會立即釋出劇毒氯氣（Cl2）。"},
    {"a": "RG01", "b": "RG07", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "EXPLOSION"], "summary": "酸與疊氮化物反應產生劇毒且易爆的疊氮酸（HN3）蒸氣。"},
    {"a": "RG01", "b": "RG10", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS"], "summary": "酸與氰化物反應會釋放致命的氰化氫（HCN）氣體。"},
    {"a": "RG01", "b": "RG19", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION", "TOXIC_GAS"], "summary": "強酸與活性金屬或還原劑反應釋出氫氣並可能起火爆炸。"},
    {"a": "RG01", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["HEAT", "TOXIC_GAS", "FIRE"], "summary": "強酸與強氧化劑混合可能產生強腐蝕性氣體或劇烈放熱。"},
    {"a": "RG01", "b": "RG17", "level": "CAUTION", "hazards": ["HEAT", "EXPLOSION"], "summary": "強酸與高濃度過氧化物接觸可能加速分解放熱。"},
    {"a": "RG01", "b": "RG06", "level": "INCOMPATIBLE", "hazards": ["HEAT"], "summary": "強酸與胺類反應劇烈放熱。"},
    {"a": "RG02", "b": "RG04", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "強氧化性酸（如濃硝酸）與醇類混合可能劇烈氧化起火甚至爆炸。"},
    {"a": "RG02", "b": "RG05", "level": "INCOMPATIBLE", "hazards": ["FIRE", "HEAT"], "summary": "強氧化性酸與醛類混合會劇烈放熱並可能起火。"},
    {"a": "RG02", "b": "RG06", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "濃硝酸等氧化性酸與胺類接觸可能自燃或爆炸。"},
    {"a": "RG02", "b": "RG07", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "EXPLOSION"], "summary": "氧化性酸與疊氮化物產生劇毒且極不穩定的疊氮酸。"},
    {"a": "RG02", "b": "RG08", "level": "INCOMPATIBLE", "hazards": ["HEAT"], "summary": "強酸與強鹼劇烈放熱噴濺。"},
    {"a": "RG02", "b": "RG09", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "HEAT"], "summary": "氧化性酸與漂白水混合釋出大量氯氣與氮氧化物。"},
    {"a": "RG02", "b": "RG10", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "EXPLOSION"], "summary": "氧化性酸與氰化物產生劇毒氰化氫氣體並可能爆炸。"},
    {"a": "RG02", "b": "RG11", "level": "INCOMPATIBLE", "hazards": ["FIRE", "HEAT"], "summary": "強氧化性酸與酯類溶劑接觸易放熱起火。"},
    {"a": "RG02", "b": "RG12", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "強氧化性酸與醚類容易形成不穩定過氧化物並引發起火爆炸。"},
    {"a": "RG02", "b": "RG14", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "強氧化性酸與烴類有機溶劑反應劇烈，可能起火爆炸。"},
    {"a": "RG02", "b": "RG15", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "強氧化性酸與酮類（如丙酮）混合可能發生劇烈放熱與爆炸。"},
    {"a": "RG02", "b": "RG18", "level": "INCOMPATIBLE", "hazards": ["FIRE", "TOXIC_GAS"], "summary": "濃硝酸與酚類反應劇烈放熱並釋放有毒氮氧化物。"},
    {"a": "RG02", "b": "RG19", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "強氧化性酸與還原劑接觸立即劇烈反應起火或爆炸。"},
    {"a": "RG03", "b": "RG08", "level": "INCOMPATIBLE", "hazards": ["HEAT"], "summary": "有機酸（如冰醋酸）與強鹼劇烈放熱。"},
    {"a": "RG03", "b": "RG09", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS"], "summary": "有機酸（如醋酸）與漂白水混合仍會釋放有毒氯氣。"},
    {"a": "RG03", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE", "HEAT"], "summary": "有機酸屬於可燃有機物，不可與強氧化劑混放。"},
    {"a": "RG03", "b": "RG17", "level": "INCOMPATIBLE", "hazards": ["EXPLOSION", "FIRE"], "summary": "醋酸與高濃度雙氧水可能形成具爆炸性之過氧乙酸。"},
    {"a": "RG04", "b": "RG09", "level": "CAUTION", "hazards": ["TOXIC_GAS", "HEAT"], "summary": "醇類與高濃度次氯酸鈉可能發生放熱氧化或生成氯仿等副產物。"},
    {"a": "RG04", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "易燃醇類與強氧化劑混放具高度起火與爆炸風險。"},
    {"a": "RG04", "b": "RG17", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "醇類與過氧化物混合可能引發劇烈氧化起火。"},
    {"a": "RG04", "b": "RG19", "level": "CAUTION", "hazards": ["FIRE", "HEAT"], "summary": "醇類與活性金屬或強還原劑反應釋出氫氣並放熱。"},
    {"a": "RG05", "b": "RG08", "level": "CAUTION", "hazards": ["HEAT", "POLYMERIZATION"], "summary": "醛類在強鹼條件下可能發生劇烈縮合或聚合放熱。"},
    {"a": "RG05", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE"], "summary": "醛類易被強氧化劑氧化並起火。"},
    {"a": "RG06", "b": "RG09", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "EXPLOSION"], "summary": "氨水／胺類與漂白水混合會產生劇毒且具爆炸性的氯胺（Chloramines）氣體。"},
    {"a": "RG06", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "胺類與強氧化劑接觸易起火。"},
    {"a": "RG06", "b": "RG13", "level": "CAUTION", "hazards": ["HEAT", "TOXIC_GAS"], "summary": "部分胺類與鹵代烴緩慢反應放熱。"},
    {"a": "RG07", "b": "RG13", "level": "INCOMPATIBLE", "hazards": ["EXPLOSION"], "summary": "疊氮化鈉與二氯甲烷、氯仿等鹵代溶劑可能生成極易爆炸的二疊氮甲烷。"},
    {"a": "RG07", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["EXPLOSION", "FIRE"], "summary": "疊氮化物與強氧化劑接觸有爆炸風險。"},
    {"a": "RG08", "b": "RG13", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "EXPLOSION"], "summary": "強鹼與氯仿等鹵代溶劑混合可能劇烈放熱並產生劇毒光氣或一氧化碳。"},
    {"a": "RG08", "b": "RG19", "level": "CAUTION", "hazards": ["FIRE"], "summary": "強鹼水溶液與鋁、鋅等兩性金屬或還原劑反應產生氫氣。"},
    {"a": "RG09", "b": "RG15", "level": "INCOMPATIBLE", "hazards": ["TOXIC_GAS", "HEAT"], "summary": "次氯酸鈉與丙酮等酮類發生鹵仿反應，產生有毒氯仿蒸氣並放熱。"},
    {"a": "RG09", "b": "RG19", "level": "INCOMPATIBLE", "hazards": ["HEAT", "TOXIC_GAS", "FIRE"], "summary": "漂白水與還原劑劇烈反應放熱並釋放有毒氣體。"},
    {"a": "RG12", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "醚類與強氧化劑混合極易起火或引爆過氧化物。"},
    {"a": "RG14", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "易燃烴類溶劑不可與強氧化劑同櫃存放。"},
    {"a": "RG15", "b": "RG16", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "酮類溶劑與強氧化劑接觸極易起火爆炸。"},
    {"a": "RG15", "b": "RG17", "level": "INCOMPATIBLE", "hazards": ["EXPLOSION"], "summary": "丙酮與雙氧水在酸性催化下會生成極度敏感的過氧化丙酮（TATP）炸藥。"},
    {"a": "RG16", "b": "RG18", "level": "INCOMPATIBLE", "hazards": ["FIRE"], "summary": "強氧化劑與酚類接觸會劇烈氧化放熱起火。"},
    {"a": "RG16", "b": "RG19", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "強氧化劑與強還原劑直接反應，極易起火或爆炸。"},
    {"a": "RG17", "b": "RG19", "level": "INCOMPATIBLE", "hazards": ["FIRE", "EXPLOSION"], "summary": "過氧化物與還原劑接觸立即劇烈分解放熱。"}
